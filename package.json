{
  "name": "merveille",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:staging": "opennextjs-cloudflare build && wrangler deploy --env staging",
    "deploy:production": "opennextjs-cloudflare build && wrangler deploy --env production",
    "migrate:staging": "wrangler d1 migrations apply DB --env staging",
    "migrate:production": "wrangler d1 migrations apply DB --env production",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:handoff": "node scripts/check-handoff.mjs",
    "test:workerd": "node scripts/check-workerd.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "types:bindings": "wrangler types src/generated/cloudflare.d.ts --env-interface WranglerBindings --include-runtime=false --include-main-module=false --strict-vars=false",
    "test:http": "node scripts/check-private-http.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "jose": "6.1.3",
    "lucide-react": "^1.16.0",
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@opennextjs/cloudflare": "1.20.18",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.4",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "playwright": "^1.50.0",
    "typescript": "^5.7.3",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    },
    "@opennextjs/cloudflare": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    }
  }
}
