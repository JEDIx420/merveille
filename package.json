{
  "name": "merveille",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:staging": "opennextjs-cloudflare build && wrangler deploy --env staging",
    "deploy:production": "opennextjs-cloudflare build && wrangler deploy --env production",
    "migrate:staging": "wrangler d1 migrations apply DB --env staging",
    "migrate:production": "wrangler d1 migrations apply DB --env production",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:handoff": "node scripts/check-handoff.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@opennextjs/cloudflare": "1.20.18",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.4",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "playwright": "^1.50.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "4.167.0"
  }
}
