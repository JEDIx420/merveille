{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "merveille-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://localhost:8787",
    "ACCESS_ISSUER": "",
    "ACCESS_AUDIENCE": "",
    "BUSINESS_TIMEZONE": "Asia/Kolkata",
    "WHATSAPP_MODE": "disabled"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "merveille-db",
      "database_id": "02c9d47f-8f7d-46fe-934b-73808c7a5d3d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROJECT_FILES",
      "bucket_name": "merveille-files"
    }
  ],
  "env": {
    "staging": {
      "name": "merveille-web-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "APP_ORIGIN": "https://merveille-web-staging.rhelo-bible.workers.dev",
        "ACCESS_ISSUER": "https://plain-dream-04be.cloudflareaccess.com",
        "ACCESS_AUDIENCE": "d5c2fdd855f563798727eff578e69c9ce3d808cb3fbf476b4477c73ca80caa30",
        "BUSINESS_TIMEZONE": "Asia/Kolkata",
        "WHATSAPP_MODE": "disabled",
        "ACCESS_ACCOUNT_ID": "2dbda19c8f37c5d767acfd842321c4a5",
        "ACCESS_APP_ID": "eb44e1d8-bd9c-437d-8bac-c5a8da71d60c",
        "ACCESS_POLICY_ID": "66d9b567-8837-42a0-b826-2115aacc5505",
        "ACCESS_GOOGLE_IDP_ID": "94487aea-8041-48ab-a17c-ec2aff33da29"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "merveille-data-staging",
          "database_id": "55b52363-a87e-4b4f-a551-607ad26c6b20",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PROJECT_FILES",
          "bucket_name": "merveille-files-staging"
        }
      ]
    },
    "production": {
      "name": "merveille-web-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://portal.merveilledesigns.com",
        "ACCESS_ISSUER": "https://merveille.cloudflareaccess.com",
        "ACCESS_AUDIENCE": "__REPLACE_PRODUCTION_ACCESS_AUDIENCE__",
        "BUSINESS_TIMEZONE": "Asia/Kolkata",
        "WHATSAPP_MODE": "disabled"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "merveille-data-production",
          "database_id": "__REPLACE_PRODUCTION_D1_ID__",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PROJECT_FILES",
          "bucket_name": "merveille-files-production"
        }
      ]
    }
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "account_id": "2dbda19c8f37c5d767acfd842321c4a5"
}
